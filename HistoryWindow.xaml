<Window x:Class="InternetSpeedWidget.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="History — last 24 hours"
        Width="700" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#FF2B2B2B">
    <StackPanel Margin="16">
        <TextBlock x:Name="SummaryText" Foreground="#FFEEEEEE" FontSize="12"
                   TextWrapping="Wrap" Margin="0,0,0,10"/>

        <DockPanel>
            <TextBlock Text="Speed" Foreground="#FFBBBBBB" FontWeight="SemiBold" DockPanel.Dock="Left"/>
            <TextBlock x:Name="SpeedScaleText" Foreground="#FF888888" FontSize="11"
                       HorizontalAlignment="Right"/>
        </DockPanel>
        <Border Background="#FF1E1E1E" CornerRadius="4" Margin="0,4,0,0">
            <Canvas x:Name="SpeedCanvas" Width="650" Height="170" ClipToBounds="True">
                <Polyline x:Name="DownSeries" Stroke="#4FC3F7" StrokeThickness="1.3"/>
                <Polyline x:Name="UpSeries" Stroke="#81C784" StrokeThickness="1.3"/>
            </Canvas>
        </Border>
        <TextBlock Foreground="#FF888888" FontSize="10" Margin="0,2,0,0">
            <Run Foreground="#4FC3F7" Text="— download"/>
            <Run Text="   "/>
            <Run Foreground="#81C784" Text="— upload"/>
        </TextBlock>

        <DockPanel Margin="0,12,0,0">
            <TextBlock Text="Ping" Foreground="#FFBBBBBB" FontWeight="SemiBold" DockPanel.Dock="Left"/>
            <TextBlock x:Name="PingScaleText" Foreground="#FF888888" FontSize="11"
                       HorizontalAlignment="Right"/>
        </DockPanel>
        <Border Background="#FF1E1E1E" CornerRadius="4" Margin="0,4,0,0">
            <Canvas x:Name="PingCanvas" Width="650" Height="90" ClipToBounds="True">
                <Polyline x:Name="PingSeries" Stroke="#FFB74D" StrokeThickness="1.3"/>
            </Canvas>
        </Border>

        <TextBlock x:Name="TimeAxisText" Foreground="#FF888888" FontSize="10" Margin="0,4,0,0"/>

        <DockPanel Margin="0,12,0,0">
            <Button x:Name="RefreshButton" Content="Refresh" Width="90" Height="28" DockPanel.Dock="Left"/>
            <Button x:Name="CloseButton" Content="Close" Width="90" Height="28"
                    HorizontalAlignment="Right"/>
        </DockPanel>
    </StackPanel>
</Window>
