<Window x:Class="InternetSpeedWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Internet Speed Widget"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">

    <Border x:Name="RootBorder"
            CornerRadius="10"
            Padding="10,7"
            Background="#CC1E1E1E">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <Grid>
        <StackPanel>

            <!-- Stacked layout: ping left third, speeds stacked on the right -->
            <Grid x:Name="StackedPanel" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="PingPanel" Grid.Column="0" VerticalAlignment="Center"
                            Margin="0,0,12,0" Visibility="Collapsed">
                    <TextBlock x:Name="PingHeader" Text="Ping" Opacity="0.75"
                               Foreground="#E040FB" FontFamily="Consolas, Segoe UI"
                               FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="PingText" Text=""
                               Foreground="#E040FB" FontFamily="Consolas, Segoe UI"
                               FontWeight="SemiBold" HorizontalAlignment="Center"/>
                </StackPanel>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Download -->
                    <Path x:Name="DownArrow" Grid.Row="0" Grid.Column="0"
                          Data="M 5,0 H 11 V 8 H 16 L 8,17 L 0,8 H 5 Z"
                          Fill="#81C784" Stretch="Uniform"
                          Width="14" Height="15"
                          VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="DownText" Grid.Row="0" Grid.Column="1"
                               Text="0.00 Mbps" Foreground="#81C784"
                               FontFamily="Consolas, Segoe UI"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"/>

                    <!-- Upload -->
                    <Path x:Name="UpArrow" Grid.Row="1" Grid.Column="0"
                          Data="M 5,17 H 11 V 9 H 16 L 8,0 L 0,9 H 5 Z"
                          Fill="#4FC3F7" Stretch="Uniform"
                          Width="14" Height="15"
                          VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="UpText" Grid.Row="1" Grid.Column="1"
                               Text="0.00 Mbps" Foreground="#4FC3F7"
                               FontFamily="Consolas, Segoe UI"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"/>
                </Grid>
            </Grid>

            <!-- Compact (one-line) layout -->
            <StackPanel x:Name="CompactPanel" Orientation="Horizontal"
                        Visibility="Collapsed" HorizontalAlignment="Center">
                <StackPanel x:Name="CPingPanel" VerticalAlignment="Center"
                            Margin="0,0,12,0" Visibility="Collapsed">
                    <TextBlock x:Name="CPingHeader" Text="Ping" Opacity="0.75"
                               Foreground="#E040FB" FontFamily="Consolas, Segoe UI"
                               FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="CPingText" Text=""
                               Foreground="#E040FB" FontFamily="Consolas, Segoe UI"
                               FontWeight="SemiBold" HorizontalAlignment="Center"/>
                </StackPanel>
                <Path x:Name="CDownArrow" Data="M 5,0 H 11 V 8 H 16 L 8,17 L 0,8 H 5 Z"
                      Fill="#81C784" Stretch="Uniform" Width="14" Height="15"
                      VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBlock x:Name="CDownText" Text="0.00 Mbps" Foreground="#81C784"
                           FontFamily="Consolas, Segoe UI" VerticalAlignment="Center"/>
                <Path x:Name="CUpArrow" Data="M 5,17 H 11 V 9 H 16 L 8,0 L 0,9 H 5 Z"
                      Fill="#4FC3F7" Stretch="Uniform" Width="14" Height="15"
                      VerticalAlignment="Center" Margin="12,0,4,0"/>
                <TextBlock x:Name="CUpText" Text="0.00 Mbps" Foreground="#4FC3F7"
                           FontFamily="Consolas, Segoe UI" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Ping + data usage line -->
            <TextBlock x:Name="InfoText" Text=""
                       Foreground="#AAAAAA" FontFamily="Consolas, Segoe UI"
                       TextAlignment="Center" Margin="0,4,0,0"
                       Visibility="Collapsed"/>

            <!-- Experimental: per-app top talker -->
            <TextBlock x:Name="TopAppText" Text=""
                       Foreground="#AAAAAA" FontFamily="Consolas, Segoe UI"
                       TextAlignment="Center" Margin="0,3,0,0"
                       Visibility="Collapsed"/>

            <!-- Speed history sparkline -->
            <Canvas x:Name="GraphCanvas" Height="26" Width="130" Margin="0,6,0,0"
                    Visibility="Collapsed" ClipToBounds="True"
                    HorizontalAlignment="Center">
                <Polyline x:Name="DownLine" Stroke="#81C784" StrokeThickness="1.5"/>
                <Polyline x:Name="UpLine" Stroke="#4FC3F7" StrokeThickness="1.5"/>
            </Canvas>

        </StackPanel>

        <!-- Experimental: traffic particle overlay -->
        <Canvas x:Name="ParticleCanvas" IsHitTestVisible="False" ClipToBounds="True"/>
        </Grid>
    </Border>
</Window>
