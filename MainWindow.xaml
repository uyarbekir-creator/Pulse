<Window x:Class="Pulse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pulse"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <!-- Slightly heavier than Normal across the widget, for legibility on
             a translucent background. Headers set SemiBold explicitly, and a
             local value beats an implicit style, so they stay heavier still. -->
        <Style TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>

        <!-- Section-header "pulse" — a slow opacity breathe echoing the app's
             name. Shared by every section header; each header's own
             EventTrigger applies it to itself (no TargetName needed). -->
        <Storyboard x:Key="HeaderPulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                              From="0.35" To="0.9" Duration="0:0:1.1">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Drag handle: the familiar 2x3 dot-grid "move me" symbol, in each
             frame's lower-left corner. The Border needs a (near) transparent
             Background to stay hit-testable across its whole area, while the
             dots themselves carry the frame's accent color. ColumnSpan covers
             the frame's whole 3-column grid so Left/Bottom really lands in
             the frame's corner. -->
        <Style x:Key="FrameGrip" TargetType="Border">
            <Setter Property="Grid.ColumnSpan" Value="3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Margin" Value="-4,0,0,-3"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Cursor" Value="SizeAll"/>
            <Setter Property="Opacity" Value="0.65"/>
            <Setter Property="Background" Value="#01FFFFFF"/>
            <Setter Property="ToolTip" Value="Drag to move this frame"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="Background" Value="#26FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- The six dots of the drag handle, drawn once and reused. Fill is
             set per frame so each handle matches its section's accent. -->
        <Geometry x:Key="GripDots">
            M0,0 A1.1,1.1 0 1 1 0,0.01 Z
            M4.4,0 A1.1,1.1 0 1 1 4.4,0.01 Z
            M0,3.4 A1.1,1.1 0 1 1 0,3.41 Z
            M4.4,3.4 A1.1,1.1 0 1 1 4.4,3.41 Z
            M0,6.8 A1.1,1.1 0 1 1 0,6.81 Z
            M4.4,6.8 A1.1,1.1 0 1 1 4.4,6.81 Z
        </Geometry>
    </Window.Resources>

    <Border x:Name="RootBorder"
            CornerRadius="10"
            Padding="10,7"
            Background="#CC1E1E1E">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <Grid Grid.IsSharedSizeScope="True">

        <!-- Modular frames. Every section is an independently positioned
             Canvas child (Canvas.Left/Top driven from code-behind), so frames
             can be dragged by their grips and snapped to each other. The
             canvas has no intrinsic size, so UpdateCanvasBounds() sets its
             Width/Height explicitly for SizeToContent to pick up. -->
        <Canvas x:Name="FrameCanvas">

        <!-- Network section: speeds, ping, usage/outage line, top talker, history graph -->
        <Border x:Name="NetworkFrame" CornerRadius="6" BorderThickness="1"
                BorderBrush="#33FFFFFF" Padding="8,6">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="NetHdr"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto" SharedSizeGroup="NetHdr"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="NetworkHeader" Grid.Column="0"
                       Text="NETWORK" Opacity="0.75"
                       Foreground="#AAAAAA" FontFamily="Consolas, Segoe UI"
                       FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center"
                       VerticalAlignment="Center" Margin="0,0,6,0">
                <TextBlock.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard Storyboard="{StaticResource HeaderPulse}"/>
                    </EventTrigger>
                </TextBlock.Triggers>
            </TextBlock>

        <StackPanel Grid.Column="1">

            <!-- Stacked layout: ping left third, speeds stacked on the right -->
            <Grid x:Name="StackedPanel" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="PingPanel" Grid.Column="0" VerticalAlignment="Center"
                            Margin="0,0,12,0" Visibility="Collapsed">
                    <TextBlock x:Name="PingHeader" Text="Ping" Opacity="0.75"
                               Foreground="#E040FB" FontFamily="Consolas, Segoe UI"
                               FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="PingText" Text=""
                               Foreground="#E040FB" FontFamily="Consolas, Segoe UI"
                               FontWeight="SemiBold" HorizontalAlignment="Center"/>
                </StackPanel>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Download -->
                    <Path x:Name="DownArrow" Grid.Row="0" Grid.Column="0"
                          Data="M 5,0 H 11 V 8 H 16 L 8,17 L 0,8 H 5 Z"
                          Fill="#81C784" Stretch="Uniform"
                          Width="14" Height="15"
                          VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="DownText" Grid.Row="0" Grid.Column="1"
                               Text="0.00 Mbps" Foreground="#81C784"
                               FontFamily="Consolas, Segoe UI"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"/>

                    <!-- Upload -->
                    <Path x:Name="UpArrow" Grid.Row="1" Grid.Column="0"
                          Data="M 5,17 H 11 V 9 H 16 L 8,0 L 0,9 H 5 Z"
                          Fill="#BA68C8" Stretch="Uniform"
                          Width="14" Height="15"
                          VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="UpText" Grid.Row="1" Grid.Column="1"
                               Text="0.00 Mbps" Foreground="#BA68C8"
                               FontFamily="Consolas, Segoe UI"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"/>
                </Grid>
            </Grid>

            <!-- Compact (one-line) layout -->
            <StackPanel x:Name="CompactPanel" Orientation="Horizontal"
                        Visibility="Collapsed" HorizontalAlignment="Center">
                <StackPanel x:Name="CPingPanel" VerticalAlignment="Center"
                            Margin="0,0,12,0" Visibility="Collapsed">
                    <TextBlock x:Name="CPingHeader" Text="Ping" Opacity="0.75"
                               Foreground="#E040FB" FontFamily="Consolas, Segoe UI"
                               FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="CPingText" Text=""
                               Foreground="#E040FB" FontFamily="Consolas, Segoe UI"
                               FontWeight="SemiBold" HorizontalAlignment="Center"/>
                </StackPanel>
                <Path x:Name="CDownArrow" Data="M 5,0 H 11 V 8 H 16 L 8,17 L 0,8 H 5 Z"
                      Fill="#81C784" Stretch="Uniform" Width="14" Height="15"
                      VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBlock x:Name="CDownText" Text="0.00 Mbps" Foreground="#81C784"
                           FontFamily="Consolas, Segoe UI" VerticalAlignment="Center"/>
                <Path x:Name="CUpArrow" Data="M 5,17 H 11 V 9 H 16 L 8,0 L 0,9 H 5 Z"
                      Fill="#BA68C8" Stretch="Uniform" Width="14" Height="15"
                      VerticalAlignment="Center" Margin="12,0,4,0"/>
                <TextBlock x:Name="CUpText" Text="0.00 Mbps" Foreground="#BA68C8"
                           FontFamily="Consolas, Segoe UI" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Ping + data usage line -->
            <TextBlock x:Name="InfoText" Text=""
                       Foreground="#AAAAAA" FontFamily="Consolas, Segoe UI"
                       TextAlignment="Center" Margin="0,4,0,0"
                       Visibility="Collapsed"/>

            <!-- Experimental: per-app top talker. Name (right-aligned) and
                 speed (right-aligned) live in separate fixed-width cells so a
                 long app name never pushes the speed number sideways or
                 reflows the frame. -->
            <Grid x:Name="TopAppPanel" Margin="0,3,0,0" Visibility="Collapsed"
                  HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TopAppNameText" Grid.Column="0" Text=""
                           Foreground="#AAAAAA" FontFamily="Consolas, Segoe UI"
                           TextAlignment="Right" TextTrimming="CharacterEllipsis"
                           Margin="0,0,8,0"/>
                <TextBlock x:Name="TopAppSpeedText" Grid.Column="1" Text=""
                           Foreground="#AAAAAA" FontFamily="Consolas, Segoe UI"
                           TextAlignment="Right"/>
            </Grid>

            <!-- Speed history sparkline -->
            <Canvas x:Name="GraphCanvas" Height="26" Width="130" Margin="0,6,0,0"
                    Visibility="Collapsed" ClipToBounds="True"
                    HorizontalAlignment="Center">
                <Polyline x:Name="DownLine" Stroke="#81C784" StrokeThickness="1.5"/>
                <Polyline x:Name="UpLine" Stroke="#BA68C8" StrokeThickness="1.5"/>
            </Canvas>

        </StackPanel>

            <Border Style="{StaticResource FrameGrip}" Tag="Network"
                    MouseLeftButtonDown="OnGripDown" MouseMove="OnGripMove"
                    MouseLeftButtonUp="OnGripUp">
                <Path Data="{StaticResource GripDots}" Fill="#AAAAAA"/>
            </Border>
        </Grid>
        </Border>

        <Border x:Name="CpuPanel" CornerRadius="6"
                BorderThickness="1" BorderBrush="#4DFFB74D" Padding="6,5">
            <Grid>
                <!-- header (left) + centered content + empty spacer that
                     mirrors the header width, so the numbers sit in the
                     true middle of the frame rather than just right of
                     the header. -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="CpuHdr"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="CpuHdr"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CpuHeader" Grid.Column="0" Text="CPU" Opacity="0.75"
                           Foreground="#FFB74D" FontFamily="Consolas, Segoe UI"
                           FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center"
                           VerticalAlignment="Center" Margin="0,0,4,0">
                    <TextBlock.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard Storyboard="{StaticResource HeaderPulse}"/>
                        </EventTrigger>
                    </TextBlock.Triggers>
                </TextBlock>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock x:Name="CpuText" Text="—"
                               Foreground="#FFB74D" FontFamily="Consolas, Segoe UI"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="CpuTopText" Text="—" Opacity="0.75"
                               Foreground="#FFB74D" FontFamily="Consolas, Segoe UI"
                               HorizontalAlignment="Center"/>
                    <Canvas x:Name="CpuGraph" Height="16" Width="56" Margin="0,2,0,0"
                            Visibility="Collapsed" ClipToBounds="True">
                        <Polyline x:Name="CpuLine" Stroke="#FFB74D" StrokeThickness="1.2"/>
                    </Canvas>
                </StackPanel>
                <Border Style="{StaticResource FrameGrip}" Tag="Cpu"
                        MouseLeftButtonDown="OnGripDown" MouseMove="OnGripMove"
                        MouseLeftButtonUp="OnGripUp">
                    <Path Data="{StaticResource GripDots}" Fill="#FFB74D"/>
                </Border>
            </Grid>
        </Border>

        <Border x:Name="RamPanel" CornerRadius="6"
                BorderThickness="1" BorderBrush="#4DB39DDB" Padding="6,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="RamHdr"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="RamHdr"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="RamHeader" Grid.Column="0" Text="RAM" Opacity="0.75"
                           Foreground="#B39DDB" FontFamily="Consolas, Segoe UI"
                           FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center"
                           VerticalAlignment="Center" Margin="0,0,4,0">
                    <TextBlock.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard Storyboard="{StaticResource HeaderPulse}"/>
                        </EventTrigger>
                    </TextBlock.Triggers>
                </TextBlock>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock x:Name="RamText" Text="—"
                               Foreground="#B39DDB" FontFamily="Consolas, Segoe UI"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="RamTopText" Text="—" Opacity="0.75"
                               Foreground="#B39DDB" FontFamily="Consolas, Segoe UI"
                               HorizontalAlignment="Center"/>
                    <Canvas x:Name="RamGraph" Height="16" Width="56" Margin="0,2,0,0"
                            Visibility="Collapsed" ClipToBounds="True">
                        <Polyline x:Name="RamLine" Stroke="#B39DDB" StrokeThickness="1.2"/>
                    </Canvas>
                </StackPanel>
                <Border Style="{StaticResource FrameGrip}" Tag="Ram"
                        MouseLeftButtonDown="OnGripDown" MouseMove="OnGripMove"
                        MouseLeftButtonUp="OnGripUp">
                    <Path Data="{StaticResource GripDots}" Fill="#B39DDB"/>
                </Border>
            </Grid>
        </Border>

        <Border x:Name="GpuPanel" CornerRadius="6"
                BorderThickness="1" BorderBrush="#4DFF8A65" Padding="6,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="GpuHdr"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="GpuHdr"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="GpuHeader" Grid.Column="0" Text="GPU" Opacity="0.75"
                           Foreground="#FF8A65" FontFamily="Consolas, Segoe UI"
                           FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center"
                           VerticalAlignment="Center" Margin="0,0,4,0">
                    <TextBlock.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard Storyboard="{StaticResource HeaderPulse}"/>
                        </EventTrigger>
                    </TextBlock.Triggers>
                </TextBlock>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock x:Name="GpuText" Text="—"
                               Foreground="#FF8A65" FontFamily="Consolas, Segoe UI"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="GpuTopText" Text="—" Opacity="0.75"
                               Foreground="#FF8A65" FontFamily="Consolas, Segoe UI"
                               HorizontalAlignment="Center"/>
                    <Canvas x:Name="GpuGraph" Height="16" Width="56" Margin="0,2,0,0"
                            Visibility="Collapsed" ClipToBounds="True">
                        <Polyline x:Name="GpuLine" Stroke="#FF8A65" StrokeThickness="1.2"/>
                    </Canvas>
                </StackPanel>
                <Border Style="{StaticResource FrameGrip}" Tag="Gpu"
                        MouseLeftButtonDown="OnGripDown" MouseMove="OnGripMove"
                        MouseLeftButtonUp="OnGripUp">
                    <Path Data="{StaticResource GripDots}" Fill="#FF8A65"/>
                </Border>
            </Grid>
        </Border>

        <Border x:Name="DiskPanel" CornerRadius="6"
                BorderThickness="1" BorderBrush="#4D4DB6AC" Padding="6,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="DiskHdr"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="DiskHdr"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="DiskHeader" Grid.Column="0" Text="DISK" Opacity="0.75"
                           Foreground="#4DB6AC" FontFamily="Consolas, Segoe UI"
                           FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center"
                           VerticalAlignment="Center" Margin="0,0,4,0">
                    <TextBlock.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard Storyboard="{StaticResource HeaderPulse}"/>
                        </EventTrigger>
                    </TextBlock.Triggers>
                </TextBlock>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock x:Name="DiskReadText" Text="—"
                               Foreground="#4DB6AC" FontFamily="Consolas, Segoe UI"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="DiskWriteText" Text="—"
                               Foreground="#4DB6AC" FontFamily="Consolas, Segoe UI"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="DiskSpaceText" Text=""
                               Foreground="#4DB6AC" Opacity="0.75"
                               FontFamily="Consolas, Segoe UI" TextAlignment="Center"
                               HorizontalAlignment="Center"/>
                </StackPanel>
                <Border Style="{StaticResource FrameGrip}" Tag="Disk"
                        MouseLeftButtonDown="OnGripDown" MouseMove="OnGripMove"
                        MouseLeftButtonUp="OnGripUp">
                    <Path Data="{StaticResource GripDots}" Fill="#4DB6AC"/>
                </Border>
            </Grid>
        </Border>

        <Border x:Name="WeatherPanel" CornerRadius="6" Visibility="Collapsed"
                BorderThickness="1" BorderBrush="#4DFFF176" Padding="6,5">
            <Grid>
                <!-- Header left, reading centered, unit picker right. The
                     outer two columns share a width group so the temperature
                     still lands in the frame's true middle. -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="WeatherEdge"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="WeatherEdge"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="WeatherHeader" Grid.Column="0" Text="WEA&#10;THER" Opacity="0.75"
                           Foreground="#FFF176" FontFamily="Consolas, Segoe UI"
                           FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center"
                           VerticalAlignment="Center" Margin="0,0,4,0">
                    <TextBlock.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard Storyboard="{StaticResource HeaderPulse}"/>
                        </EventTrigger>
                    </TextBlock.Triggers>
                </TextBlock>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock x:Name="WeatherTempText" Text="—"
                               Foreground="#FFF176" FontFamily="Consolas, Segoe UI"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="WeatherRangeText" Text="—" Opacity="0.75"
                               Foreground="#FFF176" FontFamily="Consolas, Segoe UI"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="WeatherCityText" Text="" Opacity="0.75"
                               Foreground="#FFF176" FontFamily="Consolas, Segoe UI"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Unit picker: °F on top, °C below, each with its own radio
                     dot. Switching refetches from the API rather than
                     converting locally. -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center"
                            HorizontalAlignment="Right" Margin="4,0,0,0">
                    <RadioButton x:Name="WeatherFahrenheitRadio" GroupName="WeatherUnit"
                                 Content="°F" Foreground="#FFF176" Opacity="0.8"
                                 FontFamily="Consolas, Segoe UI" Margin="0,0,0,2"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Show temperatures in Fahrenheit"
                                 Checked="OnWeatherUnitChecked"/>
                    <RadioButton x:Name="WeatherCelsiusRadio" GroupName="WeatherUnit"
                                 Content="°C" Foreground="#FFF176" Opacity="0.8"
                                 FontFamily="Consolas, Segoe UI"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Show temperatures in Celsius"
                                 Checked="OnWeatherUnitChecked"/>
                </StackPanel>
                <Border Style="{StaticResource FrameGrip}" Tag="Weather"
                        MouseLeftButtonDown="OnGripDown" MouseMove="OnGripMove"
                        MouseLeftButtonUp="OnGripUp">
                    <Path Data="{StaticResource GripDots}" Fill="#FFF176"/>
                </Border>
            </Grid>
        </Border>

        </Canvas>

        <!-- Experimental: traffic particle overlay -->
        <Canvas x:Name="ParticleCanvas" IsHitTestVisible="False" ClipToBounds="True"/>
        </Grid>
    </Border>
</Window>
