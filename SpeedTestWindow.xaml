<Window x:Class="InternetSpeedWidget.SpeedTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Speed Test"
        Width="340" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#FF2B2B2B">
    <StackPanel Margin="20">
        <TextBlock Text="Internet Speed Test" Foreground="#FFEEEEEE"
                   FontSize="16" FontWeight="SemiBold"/>
        <TextBlock Text="Measures actual line capacity against Cloudflare — separate from the passive monitor."
                   Foreground="#FF999999" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,14"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/><RowDefinition/><RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#FFEEEEEE"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="Margin" Value="0,3"/>
                </Style>
            </Grid.Resources>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Ping:" Foreground="#FFBBBBBB" Margin="0,3,12,3"/>
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="PingResult" Text="—"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="↓ Download:" Foreground="#4FC3F7" Margin="0,3,12,3"/>
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DownResult" Text="—"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="↑ Upload:" Foreground="#81C784" Margin="0,3,12,3"/>
            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="UpResult" Text="—"/>
        </Grid>

        <TextBlock x:Name="StatusText" Text="" Foreground="#FF999999" FontSize="11" Margin="0,10,0,0"/>

        <Button x:Name="StartButton" Content="Start Test" Width="110" Height="30"
                HorizontalAlignment="Center" Margin="0,14,0,0"/>
    </StackPanel>
</Window>
