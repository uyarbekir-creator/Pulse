<Window x:Class="Pulse.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pulse — Settings"
        Width="560" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="#FF2B2B2B">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFEEEEEE"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#FFBBBBBB"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,2"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFEEEEEE"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="16">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left column: selectors -->
            <StackPanel Grid.Column="0">

                <Label Content="Opacity"/>
                <DockPanel>
                    <TextBlock x:Name="OpacityValue" DockPanel.Dock="Right" Width="46"
                               TextAlignment="Right" Text="90%"/>
                    <Slider x:Name="OpacitySlider" Minimum="0.0" Maximum="1.0"
                            TickFrequency="0.1" IsSnapToTickEnabled="False"
                            Value="0.9" VerticalAlignment="Center"/>
                </DockPanel>

                <Label Content="Font size"/>
                <DockPanel>
                    <TextBlock x:Name="FontValue" DockPanel.Dock="Right" Width="30"
                               TextAlignment="Right" Text="14"/>
                    <Slider x:Name="FontSlider" Minimum="10" Maximum="28"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            VerticalAlignment="Center"/>
                </DockPanel>

                <Label Content="Refresh interval"/>
                <ComboBox x:Name="RefreshCombo"/>

                <Label Content="Speed unit"/>
                <ComboBox x:Name="UnitCombo"/>

                <Label Content="Widget size"/>
                <ComboBox x:Name="ScaleCombo"/>

                <Label Content="Theme"/>
                <ComboBox x:Name="ThemeCombo"/>

                <Label Content="Network adapter"/>
                <ComboBox x:Name="AdapterCombo"/>

                <Label Content="Dock to corner"/>
                <ComboBox x:Name="DockCombo"/>

                <Label Content="Ping host"/>
                <TextBox x:Name="PingHostBox" Background="#FF3A3A3A"
                         Foreground="#FFEEEEEE" BorderBrush="#FF555555"
                         Padding="4,3"/>
            </StackPanel>

            <!-- Right column: toggles -->
            <StackPanel Grid.Column="2">
                <Label Content="Widget content"/>
                <CheckBox x:Name="CompactCheck" Content="Compact one-line layout" Margin="0,2,0,0"/>
                <CheckBox x:Name="PingCheck" Content="Show ping (latency)"/>
                <CheckBox x:Name="UsageCheck" Content="Show data used today"/>
                <CheckBox x:Name="GraphCheck" Content="Show speed history graph"/>
                <TextBlock x:Name="UsageInfo" Foreground="#FF999999" FontSize="11"
                           Margin="0,6,0,0" TextWrapping="Wrap"/>

                <Label Content="Behavior" Margin="0,16,0,2"/>
                <CheckBox x:Name="TopmostCheck" Content="Always on top" Margin="0,2,0,0"/>
                <CheckBox x:Name="ClickThroughCheck" Content="Click-through (widget ignores mouse)"/>
                <CheckBox x:Name="TrayCheck" Content="Show speeds in tray icon"/>
                <CheckBox x:Name="HotkeyCheck" Content="Hotkey Ctrl+Alt+S shows/hides widget"/>
                <CheckBox x:Name="FullscreenCheck" Content="Hide during fullscreen apps"/>
                <CheckBox x:Name="StartupCheck" Content="Start with Windows"/>

                <TextBlock Text="Tip: with click-through on, use the tray icon to reach the menu — the widget can't be clicked."
                           TextWrapping="Wrap" Foreground="#FF999999" FontSize="11" Margin="0,14,0,0"/>
            </StackPanel>
        </Grid>

        <Border BorderBrush="#FF444444" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,4,0,0">
            <StackPanel>
                <Label Content="System Monitor" Margin="0,4,0,2"/>
                <CheckBox x:Name="SysStatsCheck" Content="Show CPU / RAM / GPU / Disk stats (AIO mode)"
                          Margin="0,2,0,0"/>
                <Grid Margin="16,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <CheckBox x:Name="SysCpuCheck" Content="CPU" Margin="0,2,0,0"/>
                        <CheckBox x:Name="SysRamCheck" Content="RAM"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <CheckBox x:Name="SysGpuCheck" Content="GPU" Margin="0,2,0,0"/>
                        <CheckBox x:Name="SysDiskCheck" Content="Disk"/>
                    </StackPanel>
                </Grid>
                <Label Content="GPU method" Margin="16,10,0,2"/>
                <ComboBox x:Name="GpuBackendCombo" Margin="16,0,0,0" HorizontalAlignment="Left" MinWidth="220"/>
                <CheckBox x:Name="SysGraphsCheck" Content="Show CPU / RAM / GPU history graphs" Margin="0,10,0,0"/>
                <CheckBox x:Name="SysSingleColumnCheck" Content="Single column (one row per metric)" Margin="0,4,0,0"/>
                <CheckBox x:Name="WeatherCheck" Content="Show weather (auto location)" Margin="0,4,0,0"/>
                <CheckBox x:Name="WeatherFahrenheitCheck" Content="Weather in Fahrenheit" Margin="16,4,0,0"/>
                <TextBlock Text="Frames are draggable: grab the small dot at a frame's lower-left corner to move it, and it snaps to the other frames' edges. Right-click → Reset Frame Layout restores the default arrangement."
                           TextWrapping="Wrap" Foreground="#FF999999" FontSize="11" Margin="0,8,0,0"/>

                <Label Content="Experimental ⚗" Margin="0,14,0,2"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <CheckBox x:Name="EmbedCheck" Content="Pin to desktop (behind all windows)" Margin="0,2,0,0"/>
                        <CheckBox x:Name="ParticleCheck" Content="Traffic particle animation"/>
                        <CheckBox x:Name="GeigerCheck" Content="Geiger counter sound"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <CheckBox x:Name="OutageCheck" Content="Outage logger + recovery alerts" Margin="0,2,0,0"/>
                        <CheckBox x:Name="PerAppCheck" Content="Per-app top talker (needs admin)"/>
                        <Button x:Name="ElevateButton" Content="Restart as administrator…"
                                Height="26" Padding="10,0" Margin="0,6,0,0"
                                HorizontalAlignment="Left" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="Pin to desktop keeps the widget glued behind every other window, resting on the desktop — it stays clickable and draggable. Per-app stats use ETW tracing and only work when the app runs as Administrator."
                           TextWrapping="Wrap" Foreground="#FF999999" FontSize="11" Margin="0,8,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="SpeedTestButton" Content="Speed Test…" Width="110" Height="28"/>
                    <Button x:Name="HistoryButton" Content="History (24 h)…" Width="110" Height="28" Margin="8,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Text="Tip: drag the widget anywhere to move it. Right-click it for quick options."
                   TextWrapping="Wrap" Foreground="#FF999999" FontSize="11" Margin="0,14,0,0"/>

        <Button x:Name="CloseButton" Content="Close" Width="80" Height="28"
                HorizontalAlignment="Right" Margin="0,12,0,0"/>
    </StackPanel>
</Window>
