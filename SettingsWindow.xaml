<Window x:Class="Pulse.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pulse — Settings"
        Width="640" Height="540"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="#FF2B2B2B">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFEEEEEE"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#FFBBBBBB"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,2"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFEEEEEE"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>

        <!-- Hint text under a group of settings. -->
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF999999"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>

        <!-- Vertical tab list down the left edge: flat rows that highlight on
             hover and fill in when selected, rather than folder-style tabs. -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#FFBBBBBB"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="6"
                                Padding="12,9" Margin="0,1,10,1">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#33FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="14">

        <!-- Footer sits outside the tabs so Close is always reachable. -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#FF444444" BorderThickness="0,1,0,0"
                Margin="0,10,0,0" Padding="0,10,0,0">
            <DockPanel>
                <Button x:Name="CloseButton" Content="Close" Width="80" Height="28"
                        DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                <TextBlock Text="Changes apply instantly. Drag the widget to move it; right-click it for quick options."
                           Style="{StaticResource Hint}" Margin="0,0,12,0" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <TabControl TabStripPlacement="Left" Background="Transparent" BorderThickness="0"
                    Padding="14,0,0,0">

            <!-- Appearance-->
            <TabItem Header="Appearance" MinWidth="118">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Label Content="Opacity"/>
                        <DockPanel>
                            <TextBlock x:Name="OpacityValue" DockPanel.Dock="Right" Width="46"
                                       TextAlignment="Right" Text="90%"/>
                            <Slider x:Name="OpacitySlider" Minimum="0.0" Maximum="1.0"
                                    TickFrequency="0.1" IsSnapToTickEnabled="False"
                                    Value="0.9" VerticalAlignment="Center"/>
                        </DockPanel>

                        <Label Content="Font size"/>
                        <DockPanel>
                            <TextBlock x:Name="FontValue" DockPanel.Dock="Right" Width="30"
                                       TextAlignment="Right" Text="14"/>
                            <Slider x:Name="FontSlider" Minimum="10" Maximum="28"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"/>
                        </DockPanel>

                        <Label Content="Widget size"/>
                        <ComboBox x:Name="ScaleCombo"/>

                        <Label Content="Theme"/>
                        <ComboBox x:Name="ThemeCombo"/>

                        <CheckBox x:Name="CompactCheck" Content="Compact one-line layout" Margin="0,14,0,0"/>

                        <TextBlock Style="{StaticResource Hint}"
                                   Text="All frames share one size so they tile neatly. Grab the dotted handle at a frame's lower-left corner to drag it anywhere; it snaps to the other frames' edges. Right-click the widget → Reset Frame Layout to start over."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Network-->
            <TabItem Header="Network" MinWidth="118">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Label Content="Refresh interval"/>
                        <ComboBox x:Name="RefreshCombo"/>

                        <Label Content="Speed unit"/>
                        <ComboBox x:Name="UnitCombo"/>

                        <Label Content="Network adapter"/>
                        <ComboBox x:Name="AdapterCombo"/>

                        <Label Content="Ping host"/>
                        <TextBox x:Name="PingHostBox" Background="#FF3A3A3A"
                                 Foreground="#FFEEEEEE" BorderBrush="#FF555555"
                                 Padding="4,3"/>

                        <Label Content="Shown on the widget" Margin="0,16,0,2"/>
                        <CheckBox x:Name="PingCheck" Content="Show ping (latency)" Margin="0,2,0,0"/>
                        <CheckBox x:Name="UsageCheck" Content="Show data used today"/>
                        <CheckBox x:Name="GraphCheck" Content="Show speed history graph"/>
                        <TextBlock x:Name="UsageInfo" Foreground="#FF999999" FontSize="11"
                                   Margin="0,10,0,0" TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="SpeedTestButton" Content="Speed Test…" Width="110" Height="28"/>
                            <Button x:Name="HistoryButton" Content="History (24 h)…" Width="110" Height="28" Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- System monitor-->
            <TabItem Header="System" MinWidth="118">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <CheckBox x:Name="SysStatsCheck" Content="Show CPU / RAM / GPU / Disk stats (AIO mode)"
                                  Margin="0,2,0,0"/>
                        <Grid Margin="16,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <CheckBox x:Name="SysCpuCheck" Content="CPU" Margin="0,2,0,0"/>
                                <CheckBox x:Name="SysRamCheck" Content="RAM"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <CheckBox x:Name="SysGpuCheck" Content="GPU" Margin="0,2,0,0"/>
                                <CheckBox x:Name="SysDiskCheck" Content="Disk"/>
                            </StackPanel>
                        </Grid>

                        <Label Content="GPU method" Margin="0,14,0,2"/>
                        <ComboBox x:Name="GpuBackendCombo" HorizontalAlignment="Left" MinWidth="240"/>

                        <CheckBox x:Name="SysGraphsCheck" Content="Show CPU / RAM / GPU history graphs" Margin="0,14,0,0"/>
                        <CheckBox x:Name="SysSingleColumnCheck" Content="Single column (one row per metric)" Margin="0,6,0,0"/>

                        <TextBlock Style="{StaticResource Hint}"
                                   Text="The CPU, RAM and GPU frames each name the process using the most of that resource. Single column only affects the default arrangement — it's the starting point for Reset Frame Layout."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Weather-->
            <TabItem Header="Weather" MinWidth="118">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <CheckBox x:Name="WeatherCheck" Content="Show weather frame" Margin="0,2,0,0"/>
                        <CheckBox x:Name="WeatherFahrenheitCheck" Content="Fahrenheit instead of Celsius" Margin="16,6,0,0"/>

                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Shows the current temperature with today's high and low. The unit can also be switched straight from the widget using the °F / °C dots on the weather frame."/>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Location is derived from your public IP address, so it follows your internet connection rather than GPS — behind a VPN it will report the VPN's location. No account or API key is needed."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Behavior-->
            <TabItem Header="Behavior" MinWidth="118">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Label Content="Dock to corner"/>
                        <ComboBox x:Name="DockCombo"/>

                        <CheckBox x:Name="TopmostCheck" Content="Always on top" Margin="0,14,0,0"/>
                        <CheckBox x:Name="ClickThroughCheck" Content="Click-through (widget ignores mouse)"/>
                        <CheckBox x:Name="TrayCheck" Content="Show speeds in tray icon"/>
                        <CheckBox x:Name="HotkeyCheck" Content="Hotkey Ctrl+Alt+S shows/hides widget"/>
                        <CheckBox x:Name="FullscreenCheck" Content="Hide during fullscreen apps"/>
                        <CheckBox x:Name="StartupCheck" Content="Start with Windows"/>

                        <TextBlock Style="{StaticResource Hint}"
                                   Text="With click-through on, the widget can't be clicked or dragged — use the tray icon to reach the menu and turn it back off."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Experimental-->
            <TabItem Header="Experimental ⚗" MinWidth="118">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <CheckBox x:Name="EmbedCheck" Content="Pin to desktop (behind all windows)" Margin="0,2,0,0"/>
                        <CheckBox x:Name="ParticleCheck" Content="Traffic particle animation"/>
                        <CheckBox x:Name="GeigerCheck" Content="Geiger counter sound"/>
                        <CheckBox x:Name="OutageCheck" Content="Outage logger + recovery alerts"/>
                        <CheckBox x:Name="PerAppCheck" Content="Per-app top talker (needs admin)"/>
                        <Button x:Name="ElevateButton" Content="Restart as administrator…"
                                Height="26" Padding="10,0" Margin="0,10,0,0"
                                HorizontalAlignment="Left" Visibility="Collapsed"/>

                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Pin to desktop keeps the widget glued behind every other window, resting on the desktop — it stays clickable and draggable. Per-app network stats use ETW tracing and only work when Pulse runs as Administrator."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
